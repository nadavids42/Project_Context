# Copy to .env and adjust as needed. Never commit .env — it is gitignored.
# All variables are optional; safe local defaults apply when unset.
# See src/project_context/config.py for validation rules.

PROJECT_CONTEXT_ENVIRONMENT=local
PROJECT_CONTEXT_DATA_DIR=data
PROJECT_CONTEXT_SQLITE_PATH=
PROJECT_CONTEXT_EVIDENCE_DIR=
PROJECT_CONTEXT_LOG_LEVEL=INFO
PROJECT_CONTEXT_OPENAI_MODEL=gpt-5.6-terra

# Manual evidence ingestion (FR-005/FR-006).
PROJECT_CONTEXT_MAX_UPLOAD_BYTES=26214400
PROJECT_CONTEXT_CHUNK_TARGET_CHARS=4000
PROJECT_CONTEXT_CHUNK_OVERLAP_RATIO=0.10

# Connector feature flags — all disabled; no connector is implemented yet.
PROJECT_CONTEXT_FEATURE_DRIVE_ENABLED=false
PROJECT_CONTEXT_FEATURE_GMAIL_ENABLED=false
PROJECT_CONTEXT_FEATURE_CALENDAR_ENABLED=false
PROJECT_CONTEXT_FEATURE_FATHOM_ENABLED=false

# Secrets (Google OAuth client/refresh tokens, Fathom API key) are never
# stored here and never committed. Per the product plan (Section 16),
# they belong in the OS keyring, or an encrypted local secrets file as a
# fallback, and are referenced elsewhere by an opaque credential_ref —
# not read directly from the environment or .env.
#
# Documented interim exception: the OS-keyring/encrypted-secrets
# subsystem itself is not built yet, so the one LLM API key currently
# used (Section 12) is read directly from the standard OPENAI_API_KEY
# environment variable — the same variable the OpenAI SDK itself looks
# for — by project_context.services.extraction.build_default_provider.
# Set it in your shell or a real (gitignored) .env, never here:
# OPENAI_API_KEY=
