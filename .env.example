# Copy to .env and adjust as needed. Never commit .env — it is gitignored.
# All variables are optional; safe local defaults apply when unset.
# See src/project_context/config.py for validation rules.

PROJECT_CONTEXT_ENVIRONMENT=local
PROJECT_CONTEXT_DATA_DIR=data
PROJECT_CONTEXT_SQLITE_PATH=
PROJECT_CONTEXT_EVIDENCE_DIR=
PROJECT_CONTEXT_LOG_LEVEL=INFO
PROJECT_CONTEXT_OPENAI_MODEL=gpt-5.6-terra

# Manual evidence ingestion (FR-005/FR-006).
PROJECT_CONTEXT_MAX_UPLOAD_BYTES=26214400
PROJECT_CONTEXT_CHUNK_TARGET_CHARS=4000
PROJECT_CONTEXT_CHUNK_OVERLAP_RATIO=0.10

# Connector feature flags — Drive is implemented (Prompt 10) but stays
# disabled by default; Gmail/Calendar/Fathom are not implemented yet.
PROJECT_CONTEXT_FEATURE_DRIVE_ENABLED=false
PROJECT_CONTEXT_FEATURE_GMAIL_ENABLED=false
PROJECT_CONTEXT_FEATURE_CALENDAR_ENABLED=false
PROJECT_CONTEXT_FEATURE_FATHOM_ENABLED=false

# Google OAuth desktop-app client (see README "Google Drive setup" for
# how to create one). Both must be set, in addition to the feature flag
# above, before the Sources & Settings page will offer to connect Drive.
# A Desktop-app OAuth client's "secret" is not confidential the way a
# server client's is (Google's own docs note installed apps cannot keep
# it secret) — it identifies the *app*, not a user, and is safe to keep
# in local config; it is still never committed here, only in your real
# (gitignored) .env.
PROJECT_CONTEXT_GOOGLE_OAUTH_CLIENT_ID=
PROJECT_CONTEXT_GOOGLE_OAUTH_CLIENT_SECRET=
# 0 = OS picks a free localhost port for the OAuth callback.
PROJECT_CONTEXT_GOOGLE_OAUTH_REDIRECT_PORT=0

# Per-user secrets (the Drive refresh token this app obtains after you
# click "Connect Google Drive", and — later — a Fathom API key) are
# never stored here and never committed. Per the product plan (Section
# 16) they live in the OS keyring, or a Fernet-encrypted local file as
# an explicit fallback (project_context.credentials.store) with its
# encryption key in a separate file, and are referenced elsewhere only
# by an opaque credential_ref — never read from the environment or .env.
#
# Documented interim exception: the one LLM API key currently used
# (Section 12) is read directly from the standard OPENAI_API_KEY
# environment variable — the same variable the OpenAI SDK itself looks
# for — by project_context.services.extraction.build_default_provider,
# rather than going through the credential store above. Set it in your
# shell or a real (gitignored) .env, never here:
# OPENAI_API_KEY=
